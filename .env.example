# 数据库密码（首次启动时设置，之后不可更改）
DB_PASSWORD=mc_activity_pass

# 初始管理员密码（首次登录后请立即在控制台修改）
INITIAL_ADMIN_PASSWORD=admin

# Session 签名密钥（生产环境请修改为随机字符串）
SESSION_SECRET=change-me-in-production

# Go 模块代理（构建时使用，默认依次尝试国内镜像与官方代理）
GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct

# ---- 使用 GitHub Actions 推送到 GHCR 的预构建镜像时，取消下面两行注释并修改 ----
# 版本号需与 Actions 手动触发时输入的版本一致（或使用 latest）
# BACKEND_IMAGE=ghcr.io/your-github-name/mc-activity-replay-backend:1.0.0
# FRONTEND_IMAGE=ghcr.io/your-github-name/mc-activity-replay-frontend:1.0.0
